generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: pooler em modo transaction (pgbouncer, porta 6543).
  url       = env("DATABASE_URL")
  // Migrações: pooler em modo session (porta 5432). O pgbouncer em modo
  // transaction não suporta os advisory locks que o `prisma migrate` usa.
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DEVELOPER
  FINANCEIRO
  CHEFE
  RESPONSAVEL
  MEMBER 
}

enum Branch {
  LOBINHO
  ESCOTEIRO
  SENIOR
  PIONEIRO
  DIRETORIA // Para membros que não estão em tropas ativas
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum NotificationOrigin {
  AUTO
  MANUAL
}

enum NotificationRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ==========================================
// MODELS DO NEXTAUTH (OBRIGATÓRIOS)
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MODELO DE USUÁRIO E VÍNCULOS (EXPANDIDO)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Foto de perfil
  password      String?   // Senha (essencial para login por credenciais)
  // Contas criadas por terceiros (ex: o chefe cadastrando um jovem) nascem com
  // uma senha provisória que a própria pessoa precisa trocar no primeiro acesso.
  // A barreira é aplicada no layout de cada área do dashboard.
  mustChangePassword Boolean @default(false)
  phone         String?   // Telefone
  role          Role      @default(MEMBER)
  branch        Branch?   // Ramo atual do escoteiro/chefe

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // Vínculo Responsável <-> Jovem
  guardianTies  FamilyTie[] @relation("DependentTies") // Onde o usuário é o Jovem
  dependentTies FamilyTie[] @relation("GuardianTies")  // Onde o usuário é o Responsável

  // Vínculos Operacionais (Tropa e Patrulha)
  troopId       String?
  troop         Troop?    @relation("TroopMembers", fields: [troopId], references: [id])
  managedTroops Troop[]   @relation("TroopManager") // Tropas que o chefe coordena
  
  patrolId      String?
  patrol        Patrol?   @relation("PatrolMembers", fields: [patrolId], references: [id])

  // Liderança de Patrulha (Para jovens)
  ledPatrols    Patrol[]  @relation("PatrolLeader")
  subLedPatrols Patrol[]  @relation("PatrolSubLeader")

  // Relações com Módulos
  financials    FinancialTransaction[] @relation("UserTransactions")
  eventRSVPs    EventRSVP[] @relation("EventAttendee")
  rsvpsConfirmed EventRSVP[] @relation("EventRSVPConfirmedBy")
  notifications Notification[] @relation("UserNotifications")
  blogPosts     BlogPost[]  @relation("BlogPostAuthor")
  reviewedPosts BlogPost[]  @relation("BlogPostReviewer")
  loans         ItemLoan[]  @relation("UserLoans")

  // Módulo de Comunicação
  sentNotifications           Notification[]        @relation("SentNotifications")
  guardianCopyNotifications   Notification[]        @relation("GuardianCopies")
  notificationRequests        NotificationRequest[] @relation("NotificationRequestsSent")
  approvedNotificationRequests NotificationRequest[] @relation("NotificationRequestsApproved")

  // Patrimônio sob responsabilidade individual
  assignedInventory InventoryItem[] @relation("AssignedInventory")

  // Documentos Pessoais
  personalDocs  Document[] @relation("UserDocuments")

  // CMS
  viewableFolders   Folder[]   @relation("FolderViewers")
  editableFolders   Folder[]   @relation("FolderEditors")
  viewableDocuments Document[] @relation("DocumentViewers")
  editableDocuments Document[] @relation("DocumentEditors")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([troopId])
  @@index([patrolId])
}

model FamilyTie {
  id           String @id @default(cuid())
  guardianId   String
  guardian     User   @relation("GuardianTies", fields: [guardianId], references: [id], onDelete: Cascade)
  dependentId  String
  dependent    User   @relation("DependentTies", fields: [dependentId], references: [id], onDelete: Cascade)
  relationship String? 

  @@unique([guardianId, dependentId]) 
}

// ==========================================
// MÓDULO OPERACIONAL: TROPAS E PATRULHAS
// ==========================================

model Troop {
  id          String   @id @default(cuid())
  name        String   // Ex: Tropa Escoteira Xavante, Alcatéia Seeonee
  branch      Branch   
  description String?  @db.Text
  
  // Liderança Adulta
  managerId   String?  // Chefe responsável
  manager     User?    @relation("TroopManager", fields: [managerId], references: [id])
  
  // Organização Interna
  members     User[]   @relation("TroopMembers")
  patrols     Patrol[] @relation("TroopPatrols") 
  
  // Módulos Vinculados à Tropa
  events      Event[]  @relation("TroopEvents")
  blogPosts   BlogPost[]
  financials  FinancialTransaction[] @relation("TroopTransactions")
  inventory   InventoryItem[]        @relation("TroopInventory")
  notifications Notification[]       @relation("TroopNotifications")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Patrol {
  id          String   @id @default(cuid())
  name        String   // Ex: Patrulha Águia, Matilha Vermelha
  
  troopId     String
  troop       Troop    @relation("TroopPatrols", fields: [troopId], references: [id], onDelete: Cascade)
  
  // Liderança Jovem
  leaderId    String?  // Monitor (Escoteiro/Sênior) ou Primo (Lobinho)
  leader      User?    @relation("PatrolLeader", fields: [leaderId], references: [id])
  
  subLeaderId String?  // Submonitor ou Segundo
  subLeader   User?    @relation("PatrolSubLeader", fields: [subLeaderId], references: [id])

  // Membros Gerais da Patrulha
  members     User[]   @relation("PatrolMembers")
  
  // Módulos Vinculados à Patrulha (Vaquinhas, barracas exclusivas, etc)
  financials  FinancialTransaction[] @relation("PatrolTransactions")
  inventory   InventoryItem[]        @relation("PatrolInventory")
  events      Event[]                @relation("PatrolEvents")
  notificationRequests NotificationRequest[] @relation("PatrolNotificationRequests")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([troopId])
  @@index([leaderId])
  @@index([subLeaderId])
}

// NOTA: o modelo `Progression` foi removido. Progressão escoteira e ficha
// médica são responsabilidade do sistema nacional; aqui esses dados entram
// como documento anexado (`Document` com `ownerId`), não como campo estruturado.

// ==========================================
// MÓDULO DE EVENTOS E CALENDÁRIO
// ==========================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  isGlobal    Boolean  @default(false)

  // Prazo para confirmar presença. Nulo = aceita até o início do evento.
  rsvpDeadline DateTime?

  // Carimbo do lembrete automático. É o que torna o job de cron idempotente:
  // a Vercel pode invocar o mesmo job duas vezes, e sem isso o grupo inteiro
  // receberia a notificação duplicada.
  rsvpReminderSentAt DateTime?
  
  // Escopo do Evento
  troopId     String?
  troop       Troop?   @relation("TroopEvents", fields: [troopId], references: [id])
  
  patrolId    String?
  patrol      Patrol?  @relation("PatrolEvents", fields: [patrolId], references: [id])

  attendees   EventRSVP[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([troopId]) 
  @@index([patrolId])
}

model EventRSVP {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // O PARTICIPANTE (o jovem ou o adulto que vai ao evento)
  userId  String
  user    User   @relation("EventAttendee", fields: [userId], references: [id], onDelete: Cascade)

  // true = vai, false = não vai.
  // "Não respondeu" é representado pela AUSÊNCIA da linha — evita um terceiro
  // estado ambíguo e mantém trivial a query de pendentes.
  status  Boolean

  // Quem registrou a resposta: o próprio participante ou o responsável legal.
  confirmedById String?
  confirmedBy   User?   @relation("EventRSVPConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Trava da hierarquia: uma vez que o responsável decide, o jovem não sobrepõe.
  isGuardianDecision Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status])
}

// ==========================================
// MÓDULO FINANCEIRO
// ==========================================

model FinancialTransaction {
  id          String            @id @default(cuid())
  title       String            
  amount      Decimal           @db.Decimal(10, 2)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  receiptUrl  String?           // Link do comprovante
  
  // RELACIONAMENTOS PARA CENTRO DE CUSTO
  userId      String?           // Pessoa que está pagando
  user        User?             @relation("UserTransactions", fields: [userId], references: [id])
  
  troopId     String?           // Caixa da Tropa
  troop       Troop?            @relation("TroopTransactions", fields: [troopId], references: [id])

  patrolId    String?           // Caixa da Patrulha
  patrol      Patrol?           @relation("PatrolTransactions", fields: [patrolId], references: [id])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId]) 
  @@index([troopId])
  @@index([patrolId])
  @@index([status]) 
}

// ==========================================
// MÓDULO DE PATRIMÔNIO (ALMOXARIFADO)
// ==========================================

model InventoryItem {
  id              String        @id @default(cuid())
  chargeNumber    String        @unique 
  name            String        
  category        String        
  quantity        Int           @default(1)
  condition       ItemCondition @default(GOOD)
  notes           String?       @db.Text
  
  isActive        Boolean       @default(true)
  dischargeReason String?       @db.Text
  dischargedAt    DateTime?
  
  // RELACIONAMENTOS PARA PROPRIEDADE DO MATERIAL
  troopId         String?       // Material pertence à Tropa?
  troop           Troop?        @relation("TroopInventory", fields: [troopId], references: [id])

  patrolId        String?       // Material exclusivo de uma Patrulha?
  patrol          Patrol?       @relation("PatrolInventory", fields: [patrolId], references: [id])

  assignedUserId  String?       // Membro responsável pelo material (carga individual)
  assignedUser    User?         @relation("AssignedInventory", fields: [assignedUserId], references: [id])

  loans           ItemLoan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([troopId])
  @@index([patrolId])
  @@index([assignedUserId])
}

model ItemLoan {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation("UserLoans", fields: [userId], references: [id])
  borrowedAt     DateTime      @default(now()) 
  expectedReturn DateTime?     
  returnedAt     DateTime?     
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ==========================================
// MÓDULO DE CMS E TRANSPARÊNCIA (NOVO EXPLORER)
// ==========================================

model Folder {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  
  parentId         String?
  parent           Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders       Folder[] @relation("SubFolders")
  
  documents        Document[]

  isPublic         Boolean  @default(true)  
  isRestrictedView Boolean  @default(false) 
  isRestrictedEdit Boolean  @default(false) 

  allowedViewers   User[]   @relation("FolderViewers")
  allowedEditors   User[]   @relation("FolderEditors")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Document {
  id               String   @id @default(cuid())
  title            String   
  description      String?  @db.Text
  fileUrl          String   
  size             Int      @default(0)
  
  // Relacionamento com a Pasta do CMS
  folderId         String?
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  
  // NOVO: Relacionamento com o Perfil do Usuário
  ownerId          String?
  owner            User?    @relation("UserDocuments", fields: [ownerId], references: [id], onDelete: Cascade)

  isPublic         Boolean  @default(true)  
  isRestrictedView Boolean  @default(false)
  isRestrictedEdit Boolean  @default(false)

  allowedViewers   User[]   @relation("DocumentViewers")
  allowedEditors   User[]   @relation("DocumentEditors")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([folderId]) 
  @@index([ownerId])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  imageUrl  String?

  status          PostStatus @default(PUBLISHED)
  reviewedById    String?
  reviewedBy      User?      @relation("BlogPostReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?    @db.Text

  authorId  String
  author    User     @relation("BlogPostAuthor", fields: [authorId], references: [id])

  troopId   String?
  troop     Troop?   @relation(fields: [troopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([troopId])
  @@index([status])
}

// ==========================================
// MÓDULO DE COMUNICAÇÃO
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  readAt    DateTime?
  linkUrl   String?

  origin    NotificationOrigin @default(MANUAL)

  // Quem disparou (nulo nos gatilhos automáticos do sistema)
  senderId  String?
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  // Quando preenchido, esta linha é a CÓPIA entregue ao responsável legal
  // referente ao jovem indicado — o título já vem prefixado com o nome dele.
  forDependentId String?
  forDependent   User?  @relation("GuardianCopies", fields: [forDependentId], references: [id], onDelete: SetNull)

  // Envio manual que originou esta notificação (auditoria/outbox)
  requestId String?
  request   NotificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // Tropa do destinatário (ou do jovem, nas cópias) no momento do envio.
  // É o recorte usado pelo painel do chefe.
  troopId   String?
  troop     Troop?   @relation("TroopNotifications", fields: [troopId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([senderId])
  @@index([troopId])
  @@index([requestId])
}

// Todo envio manual nasce como um NotificationRequest, mesmo quando não precisa
// de aprovação: ele é o registro de auditoria do que foi enviado, por quem e
// para qual público. Monitores/Submonitores criam o pedido em PENDING_APPROVAL
// e as notificações só são despachadas quando o chefe aprova.
model NotificationRequest {
  id      String @id @default(cuid())
  title   String
  message String @db.Text

  senderId String
  sender   User   @relation("NotificationRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)

  status NotificationRequestStatus @default(PENDING_APPROVAL)

  audienceType     String   // "ALL" | "USERS" | "TROOP" | "PATROL"
  troopId          String?
  patrolId         String?
  patrol           Patrol?  @relation("PatrolNotificationRequests", fields: [patrolId], references: [id], onDelete: SetNull)
  targetUserIds    String[]
  includeGuardians Boolean  @default(true)

  approverId      String?
  approver        User?     @relation("NotificationRequestsApproved", fields: [approverId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([status])
  @@index([patrolId])
  @@index([troopId])
}

// ==========================================
// MÓDULO DE PÁGINA INICIAL E FAQ (LANDING PAGE)
// ==========================================

model HomePageSettings {
  id                 String   @id @default(cuid())
  heroImage          String?  
  heroTitle          String   
  heroShortText      String   @db.Text 
  aboutText          String   @db.Text 
  aboutImage         String?  
  impactedYouthCount Int      @default(0) 

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   
  answer    String   @db.Text 
  order     Int      @default(0) 
  isActive  Boolean  @default(true) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MÓDULO INSTITUCIONAL
// ==========================================

model InstitutionalPage {
  id                String   @id @default(uuid())
  stats             Json
  historyImage      String
  historyBadgeYear  String   
  historyBadgeLabel String   
  historySubtitle   String   
  historyTitle      String   
  historyParagraphs String[] 

  compassTitle      String   
  compassSubtitle   String   
  missionText       String
  visionText        String
  valuesList        String[] 

  boardMembers      BoardMember[]
  testimonials      Testimonial[]

  updatedAt         DateTime @updatedAt
}

model BoardMember {
  id        String   @id @default(uuid())
  name      String   
  role      String   
  bio       String   
  imageUrl  String   
  
  pageId    String
  page      InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String   
  authorRole  String   
  quote       String   
  rating      Int      @default(5) 
  
  pageId      String
  page        InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}