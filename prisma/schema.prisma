generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DEVELOPER
  FINANCEIRO
  CHEFE
  RESPONSAVEL
  MEMBER 
}

enum Branch {
  LOBINHO
  ESCOTEIRO
  SENIOR
  PIONEIRO
  DIRETORIA // Para membros que não estão em tropas ativas
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

// ==========================================
// MODELS DO NEXTAUTH (OBRIGATÓRIOS)
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MODELO DE USUÁRIO E VÍNCULOS (EXPANDIDO)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Foto de perfil
  password      String?   // Senha (essencial para login por credenciais)
  phone         String?   // Telefone
  role          Role      @default(MEMBER)
  branch        Branch?   // Ramo atual do escoteiro/chefe

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // Vínculo Responsável <-> Jovem (Many-to-Many via tabela intermediária)
  guardianTies  FamilyTie[] @relation("DependentTies") // Onde o usuário é o Jovem
  dependentTies FamilyTie[] @relation("GuardianTies")  // Onde o usuário é o Responsável

  // Vínculos de Tropa
  troopId       String?
  troop         Troop?    @relation("TroopMembers", fields: [troopId], references: [id])
  managedTroops Troop[]   @relation("TroopManager") // Tropas que este usuário (Chefe) gerencia

  // Relações com Módulos
  medicalRecord MedicalRecord?
  progressions  Progression[]
  financials    FinancialTransaction[] @relation("UserTransactions")
  eventRSVPs    EventRSVP[]
  notifications Notification[]
  blogPosts     BlogPost[]
  loans  ItemLoan[]  @relation("UserLoans")

  // Controle de Acesso - Transparência (Pastas e Documentos)
  viewableFolders   Folder[]   @relation("FolderViewers")
  editableFolders   Folder[]   @relation("FolderEditors")
  viewableDocuments Document[] @relation("DocumentViewers")
  editableDocuments Document[] @relation("DocumentEditors")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Tabela Intermediária para a Relação N:N (Múltiplos Pais / Múltiplos Filhos)
model FamilyTie {
  id             String @id @default(cuid())
  
  guardianId     String
  guardian       User   @relation("GuardianTies", fields: [guardianId], references: [id], onDelete: Cascade)
  
  dependentId    String
  dependent      User   @relation("DependentTies", fields: [dependentId], references: [id], onDelete: Cascade)
  
  relationship   String? // Opcional: "Pai", "Mãe", "Avó", etc.

  @@unique([guardianId, dependentId]) // Previne vincular as mesmas duas pessoas duas vezes
}

// ==========================================
// MÓDULO OPERACIONAL ESCOTEIRO
// ==========================================

model Troop {
  id          String   @id @default(cuid())
  name        String   // Ex: Tropa Escoteira Xavante, Alcatéia Seeonee
  branch      Branch   // Ramo da tropa
  description String?  @db.Text
  
  // Relações
  managerId   String?  // Chefe responsável
  manager     User?    @relation("TroopManager", fields: [managerId], references: [id])
  members     User[]   @relation("TroopMembers")
  events      Event[]
  blogPosts   BlogPost[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MedicalRecord {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bloodType           String?  // Ex: O+, AB-
  allergies           String?  @db.Text
  continuousMeds      String?  @db.Text
  dietaryRestrictions String?  @db.Text
  emergencyContact    String?  // Nome e telefone
  healthInsurance     String?  // Plano de saúde
  notes               String?  @db.Text

  updatedAt           DateTime @updatedAt
}

model Progression {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String   // Nome do distintivo/especialidade
  category    String   // Ex: Especialidade, Insígnia, Progressão Máxima
  level       String?  // Ex: Nível 1, 2, 3
  earnedDate  DateTime? // Se nulo, está "em progresso"
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// MÓDULO DE EVENTOS E CALENDÁRIO
// ==========================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  isGlobal    Boolean  @default(false)
  
  troopId     String?
  troop       Troop?   @relation(fields: [troopId], references: [id])
  
  attendees   EventRSVP[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status    Boolean  @default(true) // True = Confirmado, False = Ausente justificado

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// ==========================================
// MÓDULO FINANCEIRO
// ==========================================

model FinancialTransaction {
  id          String            @id @default(cuid())
  title       String            // Ex: Mensalidade Março/2026
  amount      Decimal           @db.Decimal(10, 2)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  
  userId      String?           // Quem está pagando/recebendo
  user        User?             @relation("UserTransactions", fields: [userId], references: [id])
  
  receiptUrl  String?           // Link do comprovante

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ==========================================
// MÓDULO DE PATRIMÔNIO (ALMOXARIFADO)
// ==========================================

model InventoryItem {
  id              String        @id @default(cuid())
  name            String        
  category        String        
  quantity        Int           @default(1)
  condition       ItemCondition @default(GOOD)
  notes           String?       @db.Text
  
  // Relacionamento com o histórico de empréstimos
  loans           ItemLoan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Tabela de Histórico de Empréstimos
model ItemLoan {
  id              String        @id @default(cuid())
  
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User          @relation("UserLoans", fields: [userId], references: [id])
  
  borrowedAt      DateTime      @default(now()) // Data da retirada
  expectedReturn  DateTime?                     // Previsão de devolução
  returnedAt      DateTime?                     // Data REAL da devolução. Se nulo, está emprestado no momento.

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ==========================================
// MÓDULO DE CMS E TRANSPARÊNCIA (NOVO EXPLORER)
// ==========================================

model Folder {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  
  // Auto-relacionamento para subpastas (Estilo Windows Explorer)
  parentId          String?
  parent            Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders        Folder[] @relation("SubFolders")
  
  documents         Document[]

  // Visibilidade e Controle de Acesso
  isPublic          Boolean  @default(true)  // Visível no site público?
  isRestrictedView  Boolean  @default(false) // Se true, apenas admins específicos veem
  isRestrictedEdit  Boolean  @default(false) // Se true, apenas admins específicos editam

  allowedViewers    User[]   @relation("FolderViewers")
  allowedEditors    User[]   @relation("FolderEditors")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Document {
  id                String   @id @default(cuid())
  title             String   // Ex: Ata de Reunião Fev/2026
  description       String?  @db.Text
  fileUrl           String   // Link do PDF/Arquivo
  size              Int      @default(0)
  
  // Relação com a pasta (Se nulo, o arquivo está na "raiz")
  folderId          String?
  folder            Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  
  // Visibilidade e Controle de Acesso (Override específico do arquivo)
  isPublic          Boolean  @default(true)  // Visível no site público?
  isRestrictedView  Boolean  @default(false)
  isRestrictedEdit  Boolean  @default(false)

  allowedViewers    User[]   @relation("DocumentViewers")
  allowedEditors    User[]   @relation("DocumentEditors")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text // HTML ou Markdown do Rich Text
  imageUrl    String?  // Capa da postagem
  published   Boolean  @default(false)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  troopId     String?  // Se nulo, é notícia global
  troop       Troop?   @relation(fields: [troopId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// MÓDULO DE COMUNICAÇÃO
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  linkUrl   String?  // Link opcional

  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO DE PÁGINA INICIAL E FAQ (LANDING PAGE)
// ==========================================

model HomePageSettings {
  id                 String   @id @default(cuid())
  
  // Hero Section
  heroImage          String?  // URL da Foto da Hero Section
  heroTitle          String   // Texto principal
  heroShortText      String   @db.Text // Texto Curto/Subtítulo
  
  // Seção "Sobre Nós"
  aboutText          String   @db.Text // Texto da Seção
  aboutImage         String?  // Imagem da Seção
  impactedYouthCount Int      @default(0) // Número de jovens impactados

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   // Pergunta
  answer    String   @db.Text // Resposta (usando Text para respostas longas)
  order     Int      @default(0) // Útil para ordenar a exibição no front-end
  isActive  Boolean  @default(true) // Facilita esconder uma pergunta sem excluí-la
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MÓDULO INSTITUCIONAL
// ==========================================

model InstitutionalPage {
  id                  String   @id @default(uuid())

  // --- Estatísticas (Armazenado como JSON para simplificar) ---
  stats               Json

  // --- História ---
  historyImage        String
  historyBadgeYear    String   // ex: "1998"
  historyBadgeLabel   String   // ex: "Fundação"
  historySubtitle     String   // ex: "Nossas Raízes"
  historyTitle        String   // ex: "Como tudo começou..."
  historyParagraphs   String[] // Array de textos para os parágrafos

  // --- Missão, Visão e Valores (Bússola) ---
  compassTitle        String   // ex: "Nossa Bússola"
  compassSubtitle     String   // ex: "Os princípios que norteiam..."
  missionText         String
  visionText          String
  valuesList          String[] // Array ex: ["Lealdade e Honra", "Respeito ao próximo"]

  // Relacionamentos
  boardMembers        BoardMember[]
  testimonials        Testimonial[]

  updatedAt           DateTime @updatedAt
}

model BoardMember {
  id          String   @id @default(uuid())
  name        String   // ex: "Ricardo Almeida"
  role        String   // ex: "Diretor Presidente"
  bio         String   // ex: "No movimento desde 1990..."
  imageUrl    String   // URL ou path do arquivo
  
  pageId      String
  page        InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String   // ex: "Ana Paula"
  authorRole  String   // ex: "Mãe de Escoteiro"
  quote       String   // Texto do depoimento
  rating      Int      @default(5) // Quantidade de estrelas
  
  pageId      String
  page        InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}