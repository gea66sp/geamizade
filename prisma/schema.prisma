generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DEVELOPER
  FINANCEIRO
  CHEFE
  RESPONSAVEL
  MEMBER 
}

enum Branch {
  LOBINHO
  ESCOTEIRO
  SENIOR
  PIONEIRO
  DIRETORIA // Para membros que não estão em tropas ativas
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

// ==========================================
// MODELS DO NEXTAUTH (OBRIGATÓRIOS)
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MODELO DE USUÁRIO E VÍNCULOS (EXPANDIDO)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Foto de perfil
  password      String?   // Senha (essencial para login por credenciais)
  phone         String?   // Telefone
  role          Role      @default(MEMBER)
  branch        Branch?   // Ramo atual do escoteiro/chefe

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // Vínculo Responsável <-> Jovem
  guardianTies  FamilyTie[] @relation("DependentTies") // Onde o usuário é o Jovem
  dependentTies FamilyTie[] @relation("GuardianTies")  // Onde o usuário é o Responsável

  // Vínculos Operacionais (Tropa e Patrulha)
  troopId       String?
  troop         Troop?    @relation("TroopMembers", fields: [troopId], references: [id])
  managedTroops Troop[]   @relation("TroopManager") // Tropas que o chefe coordena
  
  patrolId      String?
  patrol        Patrol?   @relation("PatrolMembers", fields: [patrolId], references: [id])

  // Liderança de Patrulha (Para jovens)
  ledPatrols    Patrol[]  @relation("PatrolLeader")
  subLedPatrols Patrol[]  @relation("PatrolSubLeader")

  // Relações com Módulos
  progressions  Progression[]
  financials    FinancialTransaction[] @relation("UserTransactions")
  eventRSVPs    EventRSVP[]
  notifications Notification[]
  blogPosts     BlogPost[]
  loans         ItemLoan[]  @relation("UserLoans")

  // Documentos Pessoais
  personalDocs  Document[] @relation("UserDocuments")

  // CMS
  viewableFolders   Folder[]   @relation("FolderViewers")
  editableFolders   Folder[]   @relation("FolderEditors")
  viewableDocuments Document[] @relation("DocumentViewers")
  editableDocuments Document[] @relation("DocumentEditors")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([troopId])
  @@index([patrolId])
}

model FamilyTie {
  id           String @id @default(cuid())
  guardianId   String
  guardian     User   @relation("GuardianTies", fields: [guardianId], references: [id], onDelete: Cascade)
  dependentId  String
  dependent    User   @relation("DependentTies", fields: [dependentId], references: [id], onDelete: Cascade)
  relationship String? 

  @@unique([guardianId, dependentId]) 
}

// ==========================================
// MÓDULO OPERACIONAL: TROPAS E PATRULHAS
// ==========================================

model Troop {
  id          String   @id @default(cuid())
  name        String   // Ex: Tropa Escoteira Xavante, Alcatéia Seeonee
  branch      Branch   
  description String?  @db.Text
  
  // Liderança Adulta
  managerId   String?  // Chefe responsável
  manager     User?    @relation("TroopManager", fields: [managerId], references: [id])
  
  // Organização Interna
  members     User[]   @relation("TroopMembers")
  patrols     Patrol[] @relation("TroopPatrols") 
  
  // Módulos Vinculados à Tropa
  events      Event[]  @relation("TroopEvents")
  blogPosts   BlogPost[]
  financials  FinancialTransaction[] @relation("TroopTransactions")
  inventory   InventoryItem[]        @relation("TroopInventory")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Patrol {
  id          String   @id @default(cuid())
  name        String   // Ex: Patrulha Águia, Matilha Vermelha
  
  troopId     String
  troop       Troop    @relation("TroopPatrols", fields: [troopId], references: [id], onDelete: Cascade)
  
  // Liderança Jovem
  leaderId    String?  // Monitor (Escoteiro/Sênior) ou Primo (Lobinho)
  leader      User?    @relation("PatrolLeader", fields: [leaderId], references: [id])
  
  subLeaderId String?  // Submonitor ou Segundo
  subLeader   User?    @relation("PatrolSubLeader", fields: [subLeaderId], references: [id])

  // Membros Gerais da Patrulha
  members     User[]   @relation("PatrolMembers")
  
  // Módulos Vinculados à Patrulha (Vaquinhas, barracas exclusivas, etc)
  financials  FinancialTransaction[] @relation("PatrolTransactions")
  inventory   InventoryItem[]        @relation("PatrolInventory")
  events      Event[]                @relation("PatrolEvents")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([troopId])
  @@index([leaderId])
  @@index([subLeaderId])
}

model Progression {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title      String   
  category   String   
  level      String?  
  earnedDate DateTime? 
  notes      String?  @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// MÓDULO DE EVENTOS E CALENDÁRIO
// ==========================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  isGlobal    Boolean  @default(false)
  
  // Escopo do Evento
  troopId     String?
  troop       Troop?   @relation("TroopEvents", fields: [troopId], references: [id])
  
  patrolId    String?
  patrol      Patrol?  @relation("PatrolEvents", fields: [patrolId], references: [id])

  attendees   EventRSVP[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([troopId]) 
  @@index([patrolId])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Boolean  @default(true) 
  createdAt DateTime @default(now())
  @@unique([eventId, userId])
}

// ==========================================
// MÓDULO FINANCEIRO
// ==========================================

model FinancialTransaction {
  id          String            @id @default(cuid())
  title       String            
  amount      Decimal           @db.Decimal(10, 2)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  receiptUrl  String?           // Link do comprovante
  
  // RELACIONAMENTOS PARA CENTRO DE CUSTO
  userId      String?           // Pessoa que está pagando
  user        User?             @relation("UserTransactions", fields: [userId], references: [id])
  
  troopId     String?           // Caixa da Tropa
  troop       Troop?            @relation("TroopTransactions", fields: [troopId], references: [id])

  patrolId    String?           // Caixa da Patrulha
  patrol      Patrol?           @relation("PatrolTransactions", fields: [patrolId], references: [id])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId]) 
  @@index([troopId])
  @@index([patrolId])
  @@index([status]) 
}

// ==========================================
// MÓDULO DE PATRIMÔNIO (ALMOXARIFADO)
// ==========================================

model InventoryItem {
  id              String        @id @default(cuid())
  chargeNumber    String        @unique 
  name            String        
  category        String        
  quantity        Int           @default(1)
  condition       ItemCondition @default(GOOD)
  notes           String?       @db.Text
  
  isActive        Boolean       @default(true)
  dischargeReason String?       @db.Text
  dischargedAt    DateTime?
  
  // RELACIONAMENTOS PARA PROPRIEDADE DO MATERIAL
  troopId         String?       // Material pertence à Tropa?
  troop           Troop?        @relation("TroopInventory", fields: [troopId], references: [id])

  patrolId        String?       // Material exclusivo de uma Patrulha?
  patrol          Patrol?       @relation("PatrolInventory", fields: [patrolId], references: [id])

  loans           ItemLoan[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([troopId])
  @@index([patrolId])
}

model ItemLoan {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation("UserLoans", fields: [userId], references: [id])
  borrowedAt     DateTime      @default(now()) 
  expectedReturn DateTime?     
  returnedAt     DateTime?     
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ==========================================
// MÓDULO DE CMS E TRANSPARÊNCIA (NOVO EXPLORER)
// ==========================================

model Folder {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  
  parentId         String?
  parent           Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders       Folder[] @relation("SubFolders")
  
  documents        Document[]

  isPublic         Boolean  @default(true)  
  isRestrictedView Boolean  @default(false) 
  isRestrictedEdit Boolean  @default(false) 

  allowedViewers   User[]   @relation("FolderViewers")
  allowedEditors   User[]   @relation("FolderEditors")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Document {
  id               String   @id @default(cuid())
  title            String   
  description      String?  @db.Text
  fileUrl          String   
  size             Int      @default(0)
  
  // Relacionamento com a Pasta do CMS
  folderId         String?
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  
  // NOVO: Relacionamento com o Perfil do Usuário
  ownerId          String?
  owner            User?    @relation("UserDocuments", fields: [ownerId], references: [id], onDelete: Cascade)

  isPublic         Boolean  @default(true)  
  isRestrictedView Boolean  @default(false)
  isRestrictedEdit Boolean  @default(false)

  allowedViewers   User[]   @relation("DocumentViewers")
  allowedEditors   User[]   @relation("DocumentEditors")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([folderId]) 
  @@index([ownerId])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text 
  imageUrl  String?  
  published Boolean  @default(false)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  
  troopId   String?  
  troop     Troop?   @relation(fields: [troopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([troopId]) 
}

// ==========================================
// MÓDULO DE COMUNICAÇÃO
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  linkUrl   String?  

  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO DE PÁGINA INICIAL E FAQ (LANDING PAGE)
// ==========================================

model HomePageSettings {
  id                 String   @id @default(cuid())
  heroImage          String?  
  heroTitle          String   
  heroShortText      String   @db.Text 
  aboutText          String   @db.Text 
  aboutImage         String?  
  impactedYouthCount Int      @default(0) 

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   
  answer    String   @db.Text 
  order     Int      @default(0) 
  isActive  Boolean  @default(true) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MÓDULO INSTITUCIONAL
// ==========================================

model InstitutionalPage {
  id                String   @id @default(uuid())
  stats             Json
  historyImage      String
  historyBadgeYear  String   
  historyBadgeLabel String   
  historySubtitle   String   
  historyTitle      String   
  historyParagraphs String[] 

  compassTitle      String   
  compassSubtitle   String   
  missionText       String
  visionText        String
  valuesList        String[] 

  boardMembers      BoardMember[]
  testimonials      Testimonial[]

  updatedAt         DateTime @updatedAt
}

model BoardMember {
  id        String   @id @default(uuid())
  name      String   
  role      String   
  bio       String   
  imageUrl  String   
  
  pageId    String
  page      InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String   
  authorRole  String   
  quote       String   
  rating      Int      @default(5) 
  
  pageId      String
  page        InstitutionalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}