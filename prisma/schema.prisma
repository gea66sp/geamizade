generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  CLIENT
}

enum TimelineStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ==========================================
// MODELS DO NEXTAUTH (OBRIGATÓRIOS)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Foto de perfil
  password      String?   // Senha (essencial para login por credenciais)
  phone         String?   // Telefone
  role          Role      @default(CLIENT)

  // Relação com a Empresa (Organização)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Relações do NextAuth
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MODELS DA SUA REGRA DE NEGÓCIO
// ==========================================

model Company {
  id          String   @id @default(cuid())
  name        String
  documentId  String?  // CNPJ ou CPF
  address     String?

  // Relações
  users       User[]
  credentials ProjectCredential[]
  envVars     EnvironmentVariable[]
  documents   ProjectDocument[]
  timeline    TimelineEvent[]
  links       UsefulLink[]
  invoices    Invoice[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Senhas e logins de serviços terceiros do cliente (ex: Vercel, Supabase, Hostinger)
model ProjectCredential {
  id          String   @id @default(cuid())
  serviceName String   // Ex: "Painel da Vercel", "Hospedagem"
  link        String?
  login       String?
  password    String?  // Opcional, como você pediu
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Variáveis de ambiente (Tokens, Keys)
model EnvironmentVariable {
  id          String   @id @default(cuid())
  key         String   // Ex: "BLOB_READ_WRITE_TOKEN"
  value       String
  description String?  // Pra que serve essa variável

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Contratos, Recibos e afins
model ProjectDocument {
  id          String   @id @default(cuid())
  name        String   // Ex: "Contrato de Prestação de Serviços"
  type        String   // Ex: "Contrato", "Recibo", "Apresentação"
  fileUrl     String   // O link onde o PDF/Arquivo está salvo (ex: Vercel Blob)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// Linha do tempo do que está sendo feito
model TimelineEvent {
  id          String         @id @default(cuid())
  title       String         // Ex: "Design do Figma aprovado"
  description String?        @db.Text
  date        DateTime       @default(now())
  status      TimelineStatus @default(COMPLETED)

  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Minha Sugestão: Links Rápidos
model UsefulLink {
  id          String   @id @default(cuid())
  title       String   // Ex: "Figma do Projeto" ou "Site no Ar"
  url         String
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Minha Sugestão: Financeiro
model Invoice {
  id          String   @id @default(cuid())
  title       String   // Ex: "Parcela 1/3 - Desenvolvimento"
  amount      Float
  dueDate     DateTime
  isPaid      Boolean  @default(false)
  receiptUrl  String?  // Link do recibo após o pagamento

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}